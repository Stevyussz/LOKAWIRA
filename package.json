    "fastify": "^5.2.1",
    "maplibre-gl": "^5.24.0",
    "motion": "^14.9.0",
    "next": "15.5.28",
    "nodemailer": "^10.4.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
