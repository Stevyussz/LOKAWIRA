  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "backend:dev": "DOTENV_CONFIG_PATH=backend/.env tsx --tsconfig backend/tsconfig.json watch backend/src/server.ts",
    "backend:start": "DOTENV_CONFIG_PATH=backend/.env tsx --tsconfig backend/tsconfig.json backend/src/server.ts",
    "backend:migrate": "DOTENV_CONFIG_PATH=backend/.env tsx --tsconfig backend/tsconfig.json backend/src/migrate.ts",
    "backend:typecheck": "tsc --noEmit -p backend/tsconfig.json",
    "lint": "eslint src tests --ext .ts,.tsx",
    "test:e2e": "playwright test",
    "backend:qa": "node backend/qa/smoke.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
