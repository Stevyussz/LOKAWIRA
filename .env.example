# Salin menjadi .env.local lalu isi. Jangan commit .env.local.

# --- Frontend (terbaca browser, awalan NEXT_PUBLIC_ wajib) ---
# Kosong = pakai route Next.js bawaan (/api/...), yaitu server contoh di memori.
# Isi dengan URL backend sungguhan tanpa slash akhir, mis. https://api.lokawira.id
NEXT_PUBLIC_API_BASE_URL=

# "same-origin" (default) atau "include" jika backend memakai cookie sesi lintas origin
# (butuh CORS Access-Control-Allow-Credentials di sisi backend).
NEXT_PUBLIC_API_CREDENTIALS=same-origin

# Mode demo (data contoh, akun demo, server contoh di /api). Pakai "true" HANYA untuk demo juri.
# Kosong = mati di build produksi dan menyala otomatis saat npm run dev. Di produksi jangan diisi true.
NEXT_PUBLIC_DEMO_MODE=

# --- Server (tidak terbaca browser; hanya dipakai route AI bawaan Next.js) ---
NINE_ROUTER_BASE_URL=
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=gemini-2.5-flash
