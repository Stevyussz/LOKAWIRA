# Salin jadi backend/.env (sudah di .gitignore). Di server produksi, isi lewat secret manager / systemd, jangan di repo.

# PostgreSQL 14+ (Neon/Supabase region Singapura, atau Postgres di VPS yg sama)
DATABASE_URL=postgres://lokawira:ganti-sandi@localhost:5432/lokawira
DATABASE_SSL=false
DB_POOL_SIZE=10

BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0
# IP reverse proxy tepercaya (Nginx/Caddy) biar IP asli pengunjung kebaca. Default loopback.
# WAJIB disesuaikan saat deploy: kalo salah, semua orang kebaca 1 IP dan batas daftar/login dipakai bareng
# (server nulis peringatan di log kalo ini kejadian). Bisa berupa daftar IP/CIDR dipisah koma, mis 10.0.0.0/8
TRUST_PROXY=127.0.0.1
# origin frontend, dipisah koma, tanpa garis miring di akhir
CORS_ORIGINS=https://lokawira.vercel.app,http://localhost:3000
SESSION_MODE=bearer
# acak minimal 32 karakter, mis. hasil: openssl rand -base64 48
SESSION_SECRET=
LOG_LEVEL=info

# pengelola pertama (dibuat sekali, sandi gak pernah direset ulang). Sandi minimal 10 karakter
ADMIN_NAME=Pengelola LOKAWIRA
ADMIN_EMAIL=admin@example.id
ADMIN_PASSWORD=

# akun uji untuk Tim Kurasi (wisatawan@/mitra@/calon@/admin@lokawira.demo). Matikan setelah penjurian
DEMO_ACCOUNTS=false
DEMO_PASSWORD=demo1234

GEOFENCE_ENABLED=false
GEOFENCE_RADIUS_METERS=100

# 9router (OpenAI-compatible). Tanpa API key: Loka jawab dr data tercatat (offline), pindai objek gak memberi voucer.
# Model boleh berupa daftar dipisah koma. Server nyatet model mana yg cepat & sehat lalu nyoba itu duluan;
# kalo model pertama belum jawab dlm NINE_ROUTER_HEDGE_MS, model berikutnya ikut jalan & jawaban pertama yg dipakai.
# Yg teruji (Nov 2026): gemini-3.5-flash-lite paling cepat buat Loka; pindai paling akurat pakai gemini-3.8-flash duluan
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=gemini/gemini-3.1-flash-lite-preview,ag/gemini-3.8-flash-low,gemini/gemini-3.5-flash-lite
# model pindai foto (harus bisa lihat gambar). Kosong = pakai NINE_ROUTER_MODEL
NINE_ROUTER_VISION_MODEL=ag/gemini-3.8-flash-low,gemini/gemini-3.5-flash-lite,gemini/gemini-3.1-flash-lite-preview
# batas waktu total satu jawaban Loka (ms); lewat itu Loka jawab dr data tercatat
NINE_ROUTER_TIMEOUT_MS=15000
NINE_ROUTER_HEDGE_MS=2500
NINE_ROUTER_SCAN_TIMEOUT_MS=30000

# email lupa sandi / verifikasi
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LOKAWIRA <noreply@example.id>
FRONTEND_URL=https://lokawira.vercel.app
